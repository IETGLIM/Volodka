# Copy to .env and fill in values. Never commit .env.
# Prisma: use Accelerate URL for DATABASE_URL and direct TCP URL for DIRECT_DATABASE_URL.
# See https://www.prisma.io/docs/data-platform/accelerate/getting-started

DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY"
DIRECT_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
