# Volodka RPG — Environment Variables
# Copy this to .env and fill in real values for local development
# DO NOT commit real .env to git!

# Database (Prisma Accelerate — only needed for server-side features)
# Not used in static Vite build / Vercel SPA deployment
DATABASE_URL="postgres://user:password@host:5432/db"
DIRECT_DATABASE_URL="postgres://user:password@host:5432/db"
