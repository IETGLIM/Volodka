# Volodka RPG — Environment Variables
# Copy this to .env and fill in real values for local development
# DO NOT commit real .env to git!

# Static Vite SPA / Vercel deploy: no server DB is required for the default client build.
# Leave empty unless you run a separate backend that needs Postgres.
#
# ARCHIVED / unused by the Vite client (do not set for local SPA play):
# DATABASE_URL=
# DIRECT_DATABASE_URL=
