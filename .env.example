# FreeRouter API key (used by /api/matrix-quote Vercel Edge Function).
#
# DO NOT commit a real key to the repo. The .gitignore already excludes
# `.env*` except `.env.example` (this file).
#
# Set the actual value in the Vercel dashboard:
#   Project → Settings → Environment Variables → add FREEROUTER_KEY
# Mark it "Encrypted" and scoped to Production + Preview environments.
# NEVER prefix it with `VITE_` — VITE_ vars are inlined into the client
# bundle and would leak the key to anyone who opens DevTools.
FREEROUTER_KEY=your-key-here

# Optional: override the default model (glm-5.2). Other options returned by
# https://freerouter.eu.cc/v1/models: kiro-auto, qwen3.8-max, kimi-k3,
# gpt-5-6-luna, deepseek-v4-pro-0813.
# FREEROUTER_MODEL=glm-5.2
