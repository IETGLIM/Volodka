# Copy to `.env` for local development. Never commit real credentials.
# Prisma: pooled/accelerate URL for the app; direct URL for migrations/introspection.
# See https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/databases-connections#connection-poolers

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
