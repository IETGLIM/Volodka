# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Prisma: `url` is often the Prisma Accelerate connection string; `directUrl`
# is the direct Postgres URL (used for migrations and introspection).
# See https://www.prisma.io/docs/data-platform/accelerate

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
